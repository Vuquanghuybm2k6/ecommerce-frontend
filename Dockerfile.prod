# Stage 1: Build mã nguồn React bằng Node.js
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Nhúng biến môi trường API vào file build tĩnh của Vite
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2: Phục vụ file tĩnh bằng Nginx Alpine siêu nhẹ
FROM nginx:alpine

# Copy kết quả build từ stage 1 vào thư mục public của Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Copy file cấu hình Nginx xử lý React Router SPA
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
